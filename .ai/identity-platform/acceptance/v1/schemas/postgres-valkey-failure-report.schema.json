                "const": "Run identity.session.refresh then identity.risk.evaluate for success, failure, outage, concurrency, unknown-outcome cases using tenant_id, session_id, cache_key, failure_point and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: each injected PostgreSQL or Valkey outage follows declared fail policy and recovery rebuilds projection without accepting stale authority; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable, concurrency=pass/conflict, unknown-outcome=reconciled/unknown_commit; required artifact fields: session_id, stable_error, postgres_state_digest, valkey_state_digest, recovery_digest, recovered, session_authority_cache_results"
