    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
