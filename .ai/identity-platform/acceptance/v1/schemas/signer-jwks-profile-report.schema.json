            ],
            "properties": {
              "observation_id": {
                "const": "signer-jwks-profile-report.journey.oauth-oidc-provider.v1.behavior"
              },
              "claim_id": {
                "const": "journey.oauth-oidc-provider.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.signer-jwks-profile-report.v1"
              },
              "scenario": {
                "const": "success,failure,outage"
              },
              "preconditions": {
                "const": "Operations: identity.oauth-server.jwks, identity.oauth-server.token; exact inputs: issuer, key_id, signing_algorithm, rotation_version; initial state: active and retiring signing keys exist for issuer"
              },
              "stimulus": {
                "const": "Run identity.oauth-server.jwks then identity.oauth-server.token for success, failure, outage cases using issuer, key_id, signing_algorithm, rotation_version and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: token uses active key and allowed algorithm; JWKS publishes verification keys; rotation preserves old-token verification until retirement; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable; required artifact fields: key_id, signing_algorithm, jwks_key_count, old_token_verified, jwks_digest"
              },
              "actual_outcome": {
                "const": "Invariant: token uses active key and allowed algorithm; JWKS publishes verification keys; rotation preserves old-token verification until retirement; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable; required artifact fields: key_id, signing_algorithm, jwks_key_count, old_token_verified, jwks_digest"
              },
              "result": {
