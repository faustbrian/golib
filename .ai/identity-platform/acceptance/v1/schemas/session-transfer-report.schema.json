{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.session-transfer-report.v1",
  "title": "session-transfer-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "session-transfer-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "session-transfer-report.journey.sessions.v1.behavior"
              },
              "claim_id": {
                "const": "journey.sessions.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.session-transfer-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial,outage,replay,concurrency,cleanup,unknown-outcome"
              },
              "preconditions": {
                "const": "Operations: identity.session.transfer-generate, identity.session.transfer-consume; exact inputs: tenant_id, session_id, target_device, transfer_token; initial state: source session is active and target device is untrusted"
              },
              "stimulus": {
                "const": "Run identity.session.transfer-generate then identity.session.transfer-consume for success, failure, denial, outage, replay, concurrency, cleanup, unknown-outcome cases using tenant_id, session_id, target_device, transfer_token and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: one short-lived transfer token creates one policy-equivalent target session and is invalid after consume, expiry, or source revocation; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, replay=denied/conflict, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: transfer_id, source_session_id, target_session_id, consumed_count, replay_rejected"
              },
              "actual_outcome": {
                "const": "Invariant: one short-lived transfer token creates one policy-equivalent target session and is invalid after consume, expiry, or source revocation; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, replay=denied/conflict, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: transfer_id, source_session_id, target_session_id, consumed_count, replay_rejected"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
