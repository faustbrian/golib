{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.device-authorization-report.v1",
  "title": "device-authorization-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "device-authorization-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "device-authorization-report.journey.oauth-oidc-provider.v1.behavior"
              },
              "claim_id": {
                "const": "journey.oauth-oidc-provider.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.device-authorization-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial,outage,replay,cleanup,unknown-outcome"
              },
              "preconditions": {
                "const": "Operations: identity.oauth-server.device-authorize, identity.oauth-server.device-approve, identity.oauth-server.device-deny, identity.oauth-server.device-token; exact inputs: client_id, device_code, user_code, scopes, interval; initial state: registered device client has no authorization grant"
              },
              "stimulus": {
                "const": "Run identity.oauth-server.device-authorize then identity.oauth-server.device-approve then identity.oauth-server.device-deny then identity.oauth-server.device-token for success, failure, denial, outage, replay, cleanup, unknown-outcome cases using client_id, device_code, user_code, scopes, interval and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: pending polling respects interval, approval issues one grant, denial returns access_denied, and expired or replayed codes issue no token; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, replay=denied/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: device_code_digest, user_code_digest, poll_count, token_issued_count, terminal_status"
              },
              "actual_outcome": {
                "const": "Invariant: pending polling respects interval, approval issues one grant, denial returns access_denied, and expired or replayed codes issue no token; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, replay=denied/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: device_code_digest, user_code_digest, poll_count, token_issued_count, terminal_status"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
