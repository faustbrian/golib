              "expected_outcome": {
                "const": "Invariant: external module compiles, composes its extension, and receives complete generated schema and OpenAPI declarations; stable outcomes: success=pass/none, failure=failed/internal, cleanup=pass/none; required artifact fields: module_version_digest, compiled, extension_route_count, generated_schema_digest, openapi_digest"
