            "stderr_sha256",
            "captured_output_sha256",
            "output_artifact_path",
            "artifact_payload_binding"
          ],
          "properties": {
            "execution_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
