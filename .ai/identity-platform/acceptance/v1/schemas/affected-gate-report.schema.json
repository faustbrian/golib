                  },
                  "initial_state": {
                    "const": "selected module gate pending"
                  },
                  "stable_error": {
                    "const": "none"
                  },
                  "expected_invariant": {
                    "const": "all selected checks produce attributable pass records"
                  },
                  "observed_state_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_event_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_fields": {
                    "const": [
                      "selected_module_count",
                      "passed_module_count",
                      "gate_report_digest"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "observation_id",
                  "claim_id",
                  "scenario",
                  "operation_ids",
                  "input_fields",
                  "initial_state",
                  "status",
                  "stable_error",
                  "expected_invariant",
                  "observed_state_digest",
                  "observed_event_digest",
                  "observed_fields"
                ],
                "properties": {
                  "case_id": {
                    "const": "affected-gate-report.cross.final-acceptance.v1.behavior#failure"
                  },
                  "observation_id": {
                    "const": "affected-gate-report.cross.final-acceptance.v1.behavior"
                  },
                  "claim_id": {
                    "const": "cross.final-acceptance.v1"
                  },
                  "scenario": {
                    "const": "failure"
                  },
                  "status": {
                    "const": "failed"
                  },
                  "operation_ids": {
                    "const": [
                      "make check MODULES=pkg/identity/reference"
                    ]
                  },
                  "input_fields": {
                    "const": [
                      "module",
                      "input_root"
                    ]
                  },
                  "initial_state": {
                    "const": "selected module gate pending"
                  },
                  "stable_error": {
                    "const": "internal"
                  },
                  "expected_invariant": {
                    "const": "all selected checks produce attributable pass records"
                  },
                  "observed_state_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_event_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_fields": {
                    "const": [
                      "selected_module_count",
                      "passed_module_count",
                      "gate_report_digest"
                    ]
                  }
                }
              }
            ]
          }
        },
        "selected_module_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "passed_module_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "gate_report_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "x-semantic-rules": [
        {
          "kind": "positive",
          "fields": [
            "selected_module_count",
            "passed_module_count"
          ]
        },
        {
          "kind": "equal",
          "left": "passed_module_count",
          "right": "selected_module_count"
        }
      ],
      "allOf": [
        {
          "properties": {
            "scenario_cases": {
              "contains": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "observation_id",
                  "claim_id",
                  "scenario",
                  "operation_ids",
                  "input_fields",
                  "initial_state",
                  "status",
                  "stable_error",
                  "expected_invariant",
                  "observed_state_digest",
                  "observed_event_digest",
                  "observed_fields"
                ],
                "properties": {
                  "case_id": {
                    "const": "affected-gate-report.cross.final-acceptance.v1.behavior#success"
                  },
                  "observation_id": {
                    "const": "affected-gate-report.cross.final-acceptance.v1.behavior"
                  },
                  "claim_id": {
                    "const": "cross.final-acceptance.v1"
                  },
                  "scenario": {
                    "const": "success"
                  },
                  "status": {
                    "const": "pass"
                  },
                  "operation_ids": {
                    "const": [
                      "make check MODULES=pkg/identity/reference"
                    ]
                  },
                  "input_fields": {
                    "const": [
                      "module",
                      "input_root"
                    ]
                  },
                  "initial_state": {
                    "const": "selected module gate pending"
                  },
                  "stable_error": {
                    "const": "none"
                  },
                  "expected_invariant": {
                    "const": "all selected checks produce attributable pass records"
                  },
                  "observed_state_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_event_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "observed_fields": {
                    "const": [
                      "selected_module_count",
                      "passed_module_count",
                      "gate_report_digest"
                    ]
                  }
                }
