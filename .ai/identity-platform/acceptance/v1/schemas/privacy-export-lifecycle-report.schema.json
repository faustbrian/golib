            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
