            ],
            "properties": {
              "observation_id": {
                "const": "privacy-export-lifecycle-report.journey.privacy-export.v1.behavior"
              },
              "claim_id": {
                "const": "journey.privacy-export.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.privacy-export-lifecycle-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial,outage,concurrency,cleanup,unknown-outcome"
              },
              "preconditions": {
                "const": "Operations: identity.privacy-export.request, identity.privacy-export.status, identity.privacy-export.cancel, identity.privacy-export.download; exact inputs: tenant_id, subject_id, export_id, idempotency_key, contributor_checkpoints, worker_interrupt_after_fragment, projection_or_staged_fragment_mode; initial state: subject has exportable records and no equivalent active job; each contributor can reproduce its recorded checkpoint through a versioned projection or immutable request-transaction fragment"
              },
              "stimulus": {
                "const": "Run identity.privacy-export.request then identity.privacy-export.status then identity.privacy-export.cancel then identity.privacy-export.download for success, failure, denial, outage, concurrency, cleanup, unknown-outcome cases using tenant_id, subject_id, export_id, idempotency_key, contributor_checkpoints, worker_interrupt_after_fragment, projection_or_staged_fragment_mode and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: request captures one immutable contributor set and version vector; a worker interruption releases all database snapshots, restart reconstructs every contributor at the recorded checkpoint without a long-lived exported PostgreSQL snapshot, mixed cuts are rejected, status advances monotonically, cancel cleans artifacts, and completed download is bounded and auditable; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: export_id, job_version, exported_record_count, contributor_checkpoint_count, restart_resumed_contributor_count, worker_restart_count, long_lived_postgres_snapshot_count, mixed_cut_rejected, snapshot_version_vector_digest, restart_reconstruction_digest, temporary_artifact_count, lifecycle_event_digest"
              },
              "actual_outcome": {
                "const": "Invariant: request captures one immutable contributor set and version vector; a worker interruption releases all database snapshots, restart reconstructs every contributor at the recorded checkpoint without a long-lived exported PostgreSQL snapshot, mixed cuts are rejected, status advances monotonically, cancel cleans artifacts, and completed download is bounded and auditable; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, outage=unavailable/unavailable, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: export_id, job_version, exported_record_count, contributor_checkpoint_count, restart_resumed_contributor_count, worker_restart_count, long_lived_postgres_snapshot_count, mixed_cut_rejected, snapshot_version_vector_digest, restart_reconstruction_digest, temporary_artifact_count, lifecycle_event_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
