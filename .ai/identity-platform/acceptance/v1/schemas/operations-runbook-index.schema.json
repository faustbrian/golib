{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.operations-runbook-index.v1",
  "title": "operations-runbook-index acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "operations-runbook-index"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "operations-runbook-index.cross.operability-provider-proof.v1.behavior"
              },
              "claim_id": {
                "const": "cross.operability-provider-proof.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.operations-runbook-index.v1"
              },
              "scenario": {
                "const": "success,failure"
              },
              "preconditions": {
                "const": "Operations: identity.reference.diagnostics; exact inputs: runbook_catalog, operation_catalog, failure_class_catalog; initial state: operability requirements enumerate startup, shutdown, backup, restore, rotation, outage, and recovery actions"
              },
              "stimulus": {
                "const": "Run identity.reference.diagnostics for success, failure cases using runbook_catalog, operation_catalog, failure_class_catalog and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: every required action has one versioned owner, trigger, procedure, verification, rollback, and escalation reference; stable outcomes: success=pass/none, failure=failed/internal; required artifact fields: runbook_count, covered_action_count, missing_action_count, index_digest, owner_digest"
              },
              "actual_outcome": {
                "const": "Invariant: every required action has one versioned owner, trigger, procedure, verification, rollback, and escalation reference; stable outcomes: success=pass/none, failure=failed/internal; required artifact fields: runbook_count, covered_action_count, missing_action_count, index_digest, owner_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.ai/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": ".ai/identity-platform/evidence/artifacts/operations-runbook-index.json"
          }
        }
      },
      "minContains": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "observations": {
          "contains": {
            "type": "object",
            "required": [
              "observation_id"
            ],
            "properties": {
              "observation_id": {
                "const": "operations-runbook-index.cross.operability-provider-proof.v1.behavior"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "artifact_hashes": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": ".ai/identity-platform/evidence/executions/operations-runbook-index.json"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "x-cross-field-rules": [
    "every observations[].artifact_sha256 value must equal one artifact_hashes[].sha256 value",
    "artifact_hashes must bind the artifact-specific evidence object at .ai/identity-platform/evidence/artifacts/operations-runbook-index.json",
    "artifact_hashes must bind the separately captured coordinator execution receipt at .ai/identity-platform/evidence/executions/operations-runbook-index.json",
    "revalidation_revision is null exactly when tested_revision equals gate_execution_revision; otherwise it equals gate_execution_revision",
    "input_root is SHA-256 over RFC 8785 canonical JSON of input_manifest"
  ],
  "$defs": {
    "artifact_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "invariant_id",
        "invariant",
        "operation_ids",
        "input_digest",
        "execution",
        "scenario_cases",
        "runbook_count",
        "covered_action_count",
        "missing_action_count",
        "index_digest",
        "owner_digest"
      ],
      "properties": {
        "artifact_id": {
          "const": "operations-runbook-index"
        },
        "invariant_id": {
          "const": "operations-runbook-index.invariant"
        },
        "invariant": {
          "const": "every required action has one versioned owner, trigger, procedure, verification, rollback, and escalation reference"
        },
        "operation_ids": {
          "const": [
            "identity.reference.diagnostics"
          ]
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_identity",
            "execution_receipt_path",
            "execution_receipt_sha256",
            "capture_authority",
            "command",
            "tested_revision",
            "input_root",
            "tool",
            "environment",
            "started_at",
            "completed_at",
            "exit_status",
            "stdout",
            "stdout_byte_length",
            "stdout_sha256",
            "stderr",
            "stderr_byte_length",
            "stderr_sha256",
            "captured_output_sha256",
            "output_artifact_path",
            "artifact_payload_binding"
          ],
          "properties": {
            "execution_identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "execution_receipt_path": {
              "const": ".ai/identity-platform/evidence/executions/operations-runbook-index.json"
            },
            "execution_receipt_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "capture_authority": {
              "const": "coordinator-owned-execution-runner/v1"
            },
            "command": {
              "const": "make check MODULES=pkg/identity/reference"
