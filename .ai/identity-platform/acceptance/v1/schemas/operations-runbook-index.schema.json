                  "none",
                  "internal"
                ]
              },
              "expected_invariant": {
                "const": "every required action has one versioned owner, trigger, procedure, verification, rollback, and escalation reference"
              },
              "observed_state_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "observed_event_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "transcript_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "artifact_contract_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "observed_value_count": {
                "const": 5
              },
              "ordered_steps": {
                "const": [
                  "precondition-established",
                  "stimulus-executed",
                  "outcome-observed",
                  "transcript-bound"
                ]
              },
              "expected_operation_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "identity.reference.diagnostics"
                  ]
                }
              },
              "observed_operation_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "identity.reference.diagnostics"
                  ]
                }
              },
              "observed_values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runbook_count",
                  "covered_action_count",
                  "missing_action_count",
                  "index_digest",
                  "owner_digest"
                ],
                "properties": {
                  "runbook_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "covered_action_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "missing_action_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "index_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "owner_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "x-exact-scenario-case-fields": [
            "case_id",
            "observation_id",
            "claim_id",
            "scenario",
            "operation_ids",
            "input_fields",
            "status",
            "stable_error",
            "artifact_contract_sha256",
            "expected_operation_set",
            "observed_operation_set"
          ],
          "x-exact-scenario-cases": [
            {
              "case_id": "operations-runbook-index.cross.operability-provider-proof.v1.behavior#success",
              "observation_id": "operations-runbook-index.cross.operability-provider-proof.v1.behavior",
              "claim_id": "cross.operability-provider-proof.v1",
              "scenario": "success",
              "operation_ids": [
                "identity.reference.diagnostics"
              ],
              "input_fields": [
                "runbook_catalog",
                "operation_catalog",
                "failure_class_catalog"
              ],
              "status": "pass",
              "stable_error": "none",
              "artifact_contract_sha256": "sha256:9a1acce630d70dd3f6e4c9a1de67a1b4d36bb1279c54885a20dbbb0ac26600c5",
              "expected_operation_set": [
                "identity.reference.diagnostics"
              ],
              "observed_operation_set": [
                "identity.reference.diagnostics"
