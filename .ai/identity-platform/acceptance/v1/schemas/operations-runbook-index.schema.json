              "observation_id": "operations-runbook-index.cross.operability-provider-proof.v1.behavior",
              "claim_id": "cross.operability-provider-proof.v1",
              "scenario": "failure",
              "operation_ids": [
                "identity.reference.diagnostics"
              ],
              "input_fields": [
                "runbook_catalog",
