              "operation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "identity.reference.diagnostics"
                  ]
                }
              },
              "input_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "initial_state": {
                "const": "operability requirements enumerate startup, shutdown, backup, restore, rotation, outage, and recovery actions"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "failed"
                ]
              },
              "stable_error": {
                "type": "string",
