{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.instrumentation-report.v1",
  "title": "instrumentation-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "instrumentation-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "instrumentation-report.cross.operability-provider-proof.v1.behavior"
              },
              "claim_id": {
                "const": "cross.operability-provider-proof.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.instrumentation-report.v1"
              },
              "scenario": {
                "const": "success,failure,outage"
              },
              "preconditions": {
                "const": "Operations: identity.reference.diagnostics; exact inputs: operation_id, correlation_id, secret_shaped_inputs, deadline; initial state: metrics, logs, and traces are enabled with bounded exporters"
              },
              "stimulus": {
                "const": "Run identity.reference.diagnostics for success, failure, outage cases using operation_id, correlation_id, secret_shaped_inputs, deadline and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: one operation produces correlated metric, log, and span records with stable error class and no secret-shaped value; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable; required artifact fields: metric_record_count, log_record_count, span_record_count, redaction_match_count, telemetry_digest"
              },
              "actual_outcome": {
                "const": "Invariant: one operation produces correlated metric, log, and span records with stable error class and no secret-shaped value; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable; required artifact fields: metric_record_count, log_record_count, span_record_count, redaction_match_count, telemetry_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.ai/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": ".ai/identity-platform/evidence/artifacts/instrumentation-report.json"
          }
        }
      },
      "minContains": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "observations": {
          "contains": {
            "type": "object",
            "required": [
              "observation_id"
            ],
            "properties": {
              "observation_id": {
                "const": "instrumentation-report.cross.operability-provider-proof.v1.behavior"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "artifact_hashes": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": ".ai/identity-platform/evidence/executions/instrumentation-report.json"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "x-cross-field-rules": [
    "every observations[].artifact_sha256 value must equal one artifact_hashes[].sha256 value",
    "artifact_hashes must bind the artifact-specific evidence object at .ai/identity-platform/evidence/artifacts/instrumentation-report.json",
    "artifact_hashes must bind the separately captured coordinator execution receipt at .ai/identity-platform/evidence/executions/instrumentation-report.json",
    "revalidation_revision is null exactly when tested_revision equals gate_execution_revision; otherwise it equals gate_execution_revision",
    "input_root is SHA-256 over RFC 8785 canonical JSON of input_manifest"
  ],
  "$defs": {
    "artifact_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "invariant_id",
