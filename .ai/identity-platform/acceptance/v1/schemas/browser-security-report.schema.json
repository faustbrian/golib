{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.browser-security-report.v1",
  "title": "browser-security-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "browser-security-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/http"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "browser-security-report.cross.http-browser.v1.behavior"
              },
              "claim_id": {
                "const": "cross.http-browser.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.browser-security-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial"
              },
              "preconditions": {
                "const": "Operations: identity.oauth.popup-complete, identity.openapi.document; exact inputs: origin, csrf_token, callback_state, cookie_attributes; initial state: trusted origin and bound browser state are configured"
              },
              "stimulus": {
                "const": "Run identity.oauth.popup-complete then identity.openapi.document for success, failure, denial cases using origin, csrf_token, callback_state, cookie_attributes and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: trusted callback succeeds while untrusted origin, missing CSRF, and insecure cookie variants are rejected; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: trusted_origin_count, csrf_rejected, origin_rejected, secure_cookie_observed, same_site_mode"
              },
              "actual_outcome": {
                "const": "Invariant: trusted callback succeeds while untrusted origin, missing CSRF, and insecure cookie variants are rejected; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: trusted_origin_count, csrf_rejected, origin_rejected, secure_cookie_observed, same_site_mode"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
