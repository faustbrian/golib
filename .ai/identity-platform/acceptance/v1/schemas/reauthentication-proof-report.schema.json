            "properties": {
              "observation_id": {
                "const": "reauthentication-proof-report.journey.email-password-username.v1.behavior"
              },
              "claim_id": {
                "const": "journey.email-password-username.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.reauthentication-proof-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial,replay"
              },
              "preconditions": {
                "const": "Operations: identity.password.verify, identity.session.last-method-record, identity.session.last-method-check; exact inputs: tenant_id, user_id, password, session_id, required_freshness; initial state: authenticated session exists but has no fresh authentication proof"
              },
              "stimulus": {
                "const": "Run identity.password.verify then identity.session.last-method-record then identity.session.last-method-check for success, failure, denial, replay cases using tenant_id, user_id, password, session_id, required_freshness and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: successful verification records method and time; freshness check accepts within bound and rejects expired or different-subject proof; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, replay=denied/conflict; required artifact fields: session_id, proof_id, authentication_method, freshness_seconds, expired_proof_rejected"
              },
              "actual_outcome": {
                "const": "Invariant: successful verification records method and time; freshness check accepts within bound and rejects expired or different-subject proof; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, replay=denied/conflict; required artifact fields: session_id, proof_id, authentication_method, freshness_seconds, expired_proof_rejected"
