              },
              "preconditions": {
                "const": "Operations: identity.privacy-export.download-capability-issue, identity.privacy-export.download; exact inputs: tenant_id, export_id, subject_id, capability_ttl; initial state: completed export belongs to subject_id and has no active capability"
              },
              "stimulus": {
                "const": "Run identity.privacy-export.download-capability-issue then identity.privacy-export.download for success, failure, denial cases using tenant_id, export_id, subject_id, capability_ttl and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: one bounded capability downloads the bound export and expiry, subject mismatch, and replay return denial; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: export_id, capability_digest, download_count, replay_rejected, expiry_rejected"
              },
              "actual_outcome": {
                "const": "Invariant: one bounded capability downloads the bound export and expiry, subject mismatch, and replay return denial; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: export_id, capability_digest, download_count, replay_rejected, expiry_rejected"
