{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.backup-restore-rehearsal.v1",
  "title": "backup-restore-rehearsal acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "backup-restore-rehearsal"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "backup-restore-rehearsal.cross.persistence-recovery.v1.behavior"
              },
              "claim_id": {
                "const": "cross.persistence-recovery.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.backup-restore-rehearsal.v1"
              },
              "scenario": {
                "const": "success,failure,outage,concurrency,cleanup,unknown-outcome"
              },
              "preconditions": {
                "const": "Operations: make check MODULES=pkg/identity/reference; exact inputs: backup_id, source_revision, restore_target, encryption_key_id, credential_fixture_digest, replay_checkpoint; initial state: source database contains identities, encrypted credential material, sessions, organizations, audit rows, and a persisted replay checkpoint"
              },
              "stimulus": {
                "const": "Run make check MODULES=pkg/identity/reference for success, failure, outage, concurrency, cleanup, unknown-outcome cases using backup_id, source_revision, restore_target, encryption_key_id, credential_fixture_digest, replay_checkpoint and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: the reference module gate creates a backup, restores it into an empty rehearsal database, decrypts key and credential fixtures, resumes from the exact replay checkpoint, and proves restored row and integrity digests equal the source revision; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: backup_id, encryption_key_id, restored_identity_count, restored_credential_count, decrypted_credential_count, replayed_checkpoint_count, source_digest, restore_digest"
              },
              "actual_outcome": {
                "const": "Invariant: the reference module gate creates a backup, restores it into an empty rehearsal database, decrypts key and credential fixtures, resumes from the exact replay checkpoint, and proves restored row and integrity digests equal the source revision; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable, concurrency=pass/conflict, cleanup=pass/none, unknown-outcome=reconciled/unknown_commit; required artifact fields: backup_id, encryption_key_id, restored_identity_count, restored_credential_count, decrypted_credential_count, replayed_checkpoint_count, source_digest, restore_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
