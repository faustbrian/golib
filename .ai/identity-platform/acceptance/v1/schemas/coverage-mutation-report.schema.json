              "status": "pass",
              "stable_error": "none",
              "artifact_contract_sha256": "sha256:4d30ed3060880bdaf6b58518654e62deb136a839acf0f27013e18bc3097e3fb8",
              "expected_operation_set": [
                "make check MODULES=pkg/identity/reference"
              ],
              "observed_operation_set": [
