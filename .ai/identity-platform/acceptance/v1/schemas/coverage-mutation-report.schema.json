              "expected_invariant": {
                "const": "every package reports exact 100 percent statement coverage and every viable mutant is killed"
              },
              "observed_state_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "observed_event_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "transcript_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "artifact_contract_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "observed_value_count": {
                "const": 5
              },
              "ordered_steps": {
                "const": [
                  "precondition-established",
                  "stimulus-executed",
                  "outcome-observed",
                  "transcript-bound"
