            },
            "execution_receipt_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "capture_authority": {
              "const": "coordinator-owned-execution-runner/v1"
            },
            "command": {
              "const": "make check MODULES=pkg/identity/reference"
