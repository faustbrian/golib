              "expected_operation_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "make check MODULES=pkg/identity/reference"
                  ]
                }
              },
              "observed_operation_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "make check MODULES=pkg/identity/reference"
                  ]
                }
              },
