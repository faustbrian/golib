                "type": "object",
                "additionalProperties": false,
                "required": [
                  "package_count",
                  "statement_coverage_basis_points",
                  "viable_mutant_count",
                  "killed_mutant_count",
                  "report_digest"
                ],
                "properties": {
                  "package_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "statement_coverage_basis_points": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "viable_mutant_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "killed_mutant_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  },
                  "report_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "x-exact-scenario-case-fields": [
            "case_id",
            "observation_id",
            "claim_id",
            "scenario",
            "operation_ids",
            "input_fields",
            "status",
            "stable_error",
            "artifact_contract_sha256",
            "expected_operation_set",
            "observed_operation_set"
          ],
          "x-exact-scenario-cases": [
            {
              "case_id": "coverage-mutation-report.cross.final-acceptance.v1.behavior#success",
              "observation_id": "coverage-mutation-report.cross.final-acceptance.v1.behavior",
              "claim_id": "cross.final-acceptance.v1",
              "scenario": "success",
              "operation_ids": [
                "make check MODULES=pkg/identity/reference"
              ],
              "input_fields": [
                "package_set",
                "coverage_profiles",
                "mutation_profiles"
