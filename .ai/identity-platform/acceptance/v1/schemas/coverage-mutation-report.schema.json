              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            },
            "exit_status": {
              "const": 0
            },
            "stdout": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1048576
            },
            "stdout_byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "stdout_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "stderr": {
              "type": "string",
              "maxLength": 1048576
            },
            "stderr_byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "stderr_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "captured_output_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "output_artifact_path": {
              "const": ".ai/identity-platform/evidence/artifacts/coverage-mutation-report.json"
            },
            "artifact_payload_binding": {
              "const": "record.artifact_hashes[path,sha256]"
            }
          },
          "x-execution-proof": 2
        },
        "scenario_cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "observation_id",
              "claim_id",
              "invariant_id",
              "scenario",
              "operation_ids",
              "input_fields",
              "initial_state",
              "status",
              "stable_error",
              "expected_invariant",
              "observed_state_digest",
              "observed_event_digest",
              "transcript_sha256",
              "artifact_contract_sha256",
              "observed_value_count",
              "ordered_steps",
              "expected_operation_set",
              "observed_operation_set",
              "observed_values"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "enum": [
                  "coverage-mutation-report.cross.final-acceptance.v1.behavior#success",
