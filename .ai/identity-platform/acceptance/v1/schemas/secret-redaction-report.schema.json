{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.secret-redaction-report.v1",
  "title": "secret-redaction-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "secret-redaction-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "secret-redaction-report.cross.security-privacy.v1.behavior"
              },
              "claim_id": {
                "const": "cross.security-privacy.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.secret-redaction-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial"
              },
              "preconditions": {
                "const": "Operations: identity.reference.diagnostics, identity.reference.secret-generate; exact inputs: secret_classes, encoded_variants, partial_variants, output_surfaces; initial state: fixtures include passwords, API keys, OAuth tokens, private keys, cookies, DSNs, and derived fragments"
              },
              "stimulus": {
                "const": "Run identity.reference.diagnostics then identity.reference.secret-generate for success, failure, denial cases using secret_classes, encoded_variants, partial_variants, output_surfaces and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: errors, logs, traces, diagnostics, snapshots, and generated artifacts contain zero full or partial secret match; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: secret_class_count, output_surface_count, full_secret_match_count, partial_secret_match_count, scan_digest"
              },
              "actual_outcome": {
                "const": "Invariant: errors, logs, traces, diagnostics, snapshots, and generated artifacts contain zero full or partial secret match; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: secret_class_count, output_surface_count, full_secret_match_count, partial_secret_match_count, scan_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
