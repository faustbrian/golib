{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.scim-rfc-conformance-report.v1",
  "title": "scim-rfc-conformance-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "scim-rfc-conformance-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "scim-rfc-conformance-report.journey.scim.v1.behavior"
              },
              "claim_id": {
                "const": "journey.scim.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.scim-rfc-conformance-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial"
              },
              "preconditions": {
                "const": "Operations: identity.scim.service-provider-config, identity.scim.schemas-list, identity.scim.schema-get, identity.scim.resource-types-list, identity.scim.resource-type-get, identity.scim.search, identity.scim.user-list, identity.scim.user-search, identity.scim.user-create, identity.scim.user-get, identity.scim.user-replace, identity.scim.user-patch, identity.scim.user-delete, identity.scim.group-list, identity.scim.group-search, identity.scim.group-create, identity.scim.group-get, identity.scim.group-replace, identity.scim.group-patch, identity.scim.group-delete, identity.scim.bulk; exact inputs: schemas, search_request, attributes, excluded_attributes, filter, start_index, count, sort_by, sort_order, writable_user, writable_group, external_id, bulk_operations, fail_on_errors; initial state: pinned RFC 7643 and 7644 fixtures, resource schemas, exact advertised capabilities, and an independent SCIM client suite are loaded"
              },
              "stimulus": {
                "const": "Run identity.scim.service-provider-config then identity.scim.schemas-list then identity.scim.schema-get then identity.scim.resource-types-list then identity.scim.resource-type-get then identity.scim.search then identity.scim.user-list then identity.scim.user-search then identity.scim.user-create then identity.scim.user-get then identity.scim.user-replace then identity.scim.user-patch then identity.scim.user-delete then identity.scim.group-list then identity.scim.group-search then identity.scim.group-create then identity.scim.group-get then identity.scim.group-replace then identity.scim.group-patch then identity.scim.group-delete then identity.scim.bulk for success, failure, denial cases using schemas, search_request, attributes, excluded_attributes, filter, start_index, count, sort_by, sort_order, writable_user, writable_group, external_id, bulk_operations, fail_on_errors and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: every advertised discovery, User, Group, GET list, POST search, replace, PATCH, delete, and Bulk operation matches pinned RFC fixtures; collections use exact ListResponse envelopes; writable inputs reject id and meta; externalId remains non-unique; scimType is omitted without a registered exact condition; Bulk results include method and conditional bulkId; failOnErrors rejects values above 100; ETag, filter, sort, projection, and pagination claims are exact; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: conformance_case_count, passed_case_count, advertised_operation_count, covered_operation_count, schema_digest, search_response_digest, filter_result_digest, sort_result_digest, etag_digest, bulk_response_digest"
              },
              "actual_outcome": {
                "const": "Invariant: every advertised discovery, User, Group, GET list, POST search, replace, PATCH, delete, and Bulk operation matches pinned RFC fixtures; collections use exact ListResponse envelopes; writable inputs reject id and meta; externalId remains non-unique; scimType is omitted without a registered exact condition; Bulk results include method and conditional bulkId; failOnErrors rejects values above 100; ETag, filter, sort, projection, and pagination claims are exact; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: conformance_case_count, passed_case_count, advertised_operation_count, covered_operation_count, schema_digest, search_response_digest, filter_result_digest, sort_result_digest, etag_digest, bulk_response_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.ai/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": ".ai/identity-platform/evidence/artifacts/scim-rfc-conformance-report.json"
          }
        }
      },
      "minContains": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "observations": {
          "contains": {
            "type": "object",
            "required": [
              "observation_id"
            ],
            "properties": {
              "observation_id": {
                "const": "scim-rfc-conformance-report.journey.scim.v1.behavior"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "artifact_hashes": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": ".ai/identity-platform/evidence/executions/scim-rfc-conformance-report.json"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "x-cross-field-rules": [
    "every observations[].artifact_sha256 value must equal one artifact_hashes[].sha256 value",
    "artifact_hashes must bind the artifact-specific evidence object at .ai/identity-platform/evidence/artifacts/scim-rfc-conformance-report.json",
    "artifact_hashes must bind the separately captured coordinator execution receipt at .ai/identity-platform/evidence/executions/scim-rfc-conformance-report.json",
    "revalidation_revision is null exactly when tested_revision equals gate_execution_revision; otherwise it equals gate_execution_revision",
    "input_root is SHA-256 over RFC 8785 canonical JSON of input_manifest"
  ],
