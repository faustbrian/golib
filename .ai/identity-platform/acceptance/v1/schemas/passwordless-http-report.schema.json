{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.passwordless-http-report.v1",
  "title": "passwordless-http-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "passwordless-http-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "passwordless-http-report.journey.passwordless.v1.behavior"
              },
              "claim_id": {
                "const": "journey.passwordless.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.passwordless-http-report.v1"
              },
              "scenario": {
                "const": "success,failure,denial,replay"
              },
              "preconditions": {
                "const": "Operations: identity.magic-link.request, identity.magic-link.consume, identity.otp.signin; exact inputs: tenant_id, identifier, redirect_uri, token_or_code, remember; initial state: passwordless request is rate-eligible and identifier disclosure is suppressed"
              },
              "stimulus": {
                "const": "Run identity.magic-link.request then identity.magic-link.consume then identity.otp.signin for success, failure, denial, replay cases using tenant_id, identifier, redirect_uri, token_or_code, remember and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: request returns equivalent response, valid token or code creates one policy-bound session, and replay creates none; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, replay=denied/conflict; required artifact fields: challenge_id, session_id, equivalent_response_digest, replay_rejected, security_event_digest"
              },
              "actual_outcome": {
                "const": "Invariant: request returns equivalent response, valid token or code creates one policy-bound session, and replay creates none; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden, replay=denied/conflict; required artifact fields: challenge_id, session_id, equivalent_response_digest, replay_rejected, security_event_digest"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    },
    "artifact_hashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.ai/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": ".ai/identity-platform/evidence/artifacts/passwordless-http-report.json"
          }
        }
      },
      "minContains": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "properties": {
        "observations": {
          "contains": {
            "type": "object",
            "required": [
              "observation_id"
            ],
            "properties": {
              "observation_id": {
                "const": "passwordless-http-report.journey.passwordless.v1.behavior"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "artifact_hashes": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": ".ai/identity-platform/evidence/executions/passwordless-http-report.json"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "x-cross-field-rules": [
    "every observations[].artifact_sha256 value must equal one artifact_hashes[].sha256 value",
    "artifact_hashes must bind the artifact-specific evidence object at .ai/identity-platform/evidence/artifacts/passwordless-http-report.json",
    "artifact_hashes must bind the separately captured coordinator execution receipt at .ai/identity-platform/evidence/executions/passwordless-http-report.json",
    "revalidation_revision is null exactly when tested_revision equals gate_execution_revision; otherwise it equals gate_execution_revision",
    "input_root is SHA-256 over RFC 8785 canonical JSON of input_manifest"
  ],
