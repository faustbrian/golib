                "const": "composition-collision-report.journey.typed-modules-operations.v1.behavior"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "artifact_hashes": {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": ".ai/identity-platform/evidence/executions/composition-collision-report.json"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "x-cross-field-rules": [
    "every observations[].artifact_sha256 value must equal one artifact_hashes[].sha256 value",
    "artifact_hashes must bind the artifact-specific evidence object at .ai/identity-platform/evidence/artifacts/composition-collision-report.json",
    "artifact_hashes must bind the separately captured coordinator execution receipt at .ai/identity-platform/evidence/executions/composition-collision-report.json",
    "revalidation_revision is null exactly when tested_revision equals gate_execution_revision; otherwise it equals gate_execution_revision",
    "input_root is SHA-256 over RFC 8785 canonical JSON of input_manifest"
  ],
