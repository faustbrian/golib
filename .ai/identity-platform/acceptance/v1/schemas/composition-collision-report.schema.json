{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity-platform.acceptance.composition-collision-report.v1",
  "title": "composition-collision-report acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "result",
    "tested_revision",
    "gate_execution_revision",
    "revalidation_revision",
    "input_manifest",
    "input_root",
    "tool_environment",
    "observations",
    "artifact_hashes",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_id": {
      "const": "composition-collision-report"
    },
    "result": {
      "const": {
        "status": "pass",
        "gate": "make check MODULES=pkg/identity/reference"
      }
    },
    "tested_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gate_execution_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "revalidation_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_environment_id",
          "kind",
          "content_identity",
          "owner",
          "reason"
        ],
        "properties": {
          "path_or_environment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "content_identity": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "environment"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "claim_id",
              "contract_reference",
              "scenario",
              "preconditions",
              "stimulus",
              "expected_outcome",
              "actual_outcome",
              "result",
              "artifact_sha256"
            ],
            "properties": {
              "observation_id": {
                "const": "composition-collision-report.journey.typed-modules-operations.v1.behavior"
              },
              "claim_id": {
                "const": "journey.typed-modules-operations.v1"
              },
              "contract_reference": {
                "const": "identity-platform.acceptance.composition-collision-report.v1"
              },
              "scenario": {
                "const": "success,failure"
              },
              "preconditions": {
                "const": "Operations: identity.reference.config-validate; exact inputs: route_ids, schema_ids, migration_ids, middleware_ids; initial state: two selected modules contribute the same identifier"
              },
              "stimulus": {
                "const": "Run identity.reference.config-validate for success, failure cases using route_ids, schema_ids, migration_ids, middleware_ids and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: composition rejects duplicate route, schema, migration, and middleware identifiers before service startup; stable outcomes: success=pass/none, failure=failed/internal; required artifact fields: route_collision_count, schema_collision_count, migration_collision_count, middleware_collision_count, stable_error"
              },
              "actual_outcome": {
                "const": "Invariant: composition rejects duplicate route, schema, migration, and middleware identifiers before service startup; stable outcomes: success=pass/none, failure=failed/internal; required artifact fields: route_collision_count, schema_collision_count, migration_collision_count, middleware_collision_count, stable_error"
              },
              "result": {
                "const": "pass"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
