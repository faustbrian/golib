              },
              "stimulus": {
                "const": "Run identity.apikey.create then identity.apikey.rotate then identity.apikey.verify for success, failure, outage, concurrency, unknown-outcome cases using tenant_id, api_key_id, rotation_version, idempotency_key, debit_operation_id, debit_failure_point and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: one concurrent rotation wins; every allow follows a fresh PostgreSQL-authoritative decision; cache miss, stale projection, epoch loss and nil authority never allow; a disconnect around quota mutation returns definitely-not-debited, debited, or possibly-debited with the same operation ID, possible debit blocks retry, and reconciliation converges without a duplicate debit; stable outcomes: success=pass/none, failure=failed/internal, outage=unavailable/unavailable, concurrency=pass/conflict, unknown-outcome=reconciled/unknown_commit; required artifact fields: api_key_id, debit_operation_id, winner_version, conflict_count, possible_debit_count, reconciled_debit_count, duplicate_debit_count, authoritative_verification_count, postgres_state_digest, valkey_state_digest, debit_journal_digest, possibly_debited_results"
              },
